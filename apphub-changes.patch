+/**
+ * نموذج بيانات المقارنات + محتوى المقارنات نفسه
+ * أي مقارنة جديدة = عنصر جديد في المصفوفة بس، والصفحة بتتولد أوتوماتيك.
+ */
+
+export interface ComparisonAppRef {
+  /** نفس slug بتاع صفحة التطبيق في /apps/[slug] */
+  appSlug: string;
+  /** الاسم المعروض بالعربي */
+  name: string;
+  /** إيموجي أو مسار لوجو */
+  icon: string;
+  /** تقييم التطبيق المعروض في الدليل */
+  rating: number;
+}
+
+export interface CriterionRow {
+  label: string;
+  /** قيمة كل تطبيق بالترتيب نفسه بتاع apps[] */
+  values: string[];
+  /** رقم التطبيق الفائز في الصف ده (اختياري — بيتحدد بالهايلايت) */
+  winner?: number;
+}
+
+export interface PricingPlan {
+  appIndex: number;
+  name: string;
+  /** السعر نص جاهز للعرض، مثال: "١٠٠ ج.م / شهريًا" */
+  price: string;
+  note?: string;
+}
+
+export interface CountryPricing {
+  country: string;
+  plans: PricingPlan[];
+  /** تنويه أسفل الجدول، مثال: الأسعار لا تشمل الضريبة */
+  footnote?: string;
+}
+
+export interface ComparisonFAQ {
+  q: string;
+  a: string;
+}
+
+export interface Comparison {
+  /** مقطع الرابط: netflix-vs-shahid — إنجليزي lowercase، متكررش مرتين */
+  slug: string;
+  category: string;
+  apps: ComparisonAppRef[];
+
+  /** SEO */
+  metaTitle: string;
+  metaDescription: string;
+  /** العنوان الرئيسي الظاهر fو الصفحة */
+  h1: string;
+  intro: string;
+
+  /** الخلاصة السريعة */
+  verdict: string;
+  /** "الأفضل لو..." لكل موقف */
+  bestFor: { appIndex: number; label: string }[];
+
+  criteria: CriterionRow[];
+  pros: string[][];
+  cons: string[][];
+  pricing: CountryPricing[];
+  faq: ComparisonFAQ[];
+  /** slugs مقارنات ذات صلة — بتظهر أسفل الصفحة (روابط داخلية) */
+  related: string[];
+
+  /** ISO date — بيطلع في الصفحة وفي schema وlastmod */
+  updatedAt: string;
+}
+
+export const comparisons: Comparison[] = [
+  {
+    slug: 'netflix-vs-shahid',
+    category: 'ستريمنج',
+    apps: [
+      { appSlug: 'netflix', name: 'نتفليكس', icon: '🎬', rating: 4.7 },
+      { appSlug: 'shahid', name: 'شاهد VIP', icon: '📺', rating: 4.5 },
+    ],
+    metaTitle: 'نتفليكس vs شاهد VIP: مقارنة شاملة بالأسعار 2026',
+    metaDescription:
+      'مقارنة تفصيلية بين نتفليكس وشاهد VIP: الأسعار في مصر والسعودية، المحتوى العربي والعالمي، جودة العرض، عدد الأجهزة، والخلاصة — أنهي منصة تستحق فلوسك؟',
+    h1: 'نتفليكس vs شاهد VIP',
+    intro:
+      'أشهر سؤال ستريمنج في العالم العربي: أدفع في أنهي منصة؟ جمعنالك الأسعار الحالية في مصر والسعودية، وقارنّا المحتوى والجودة والميزات بند ببند — عشان تختار اللي يناسبك فعلًا مش اللي الإعلانات بتقولك عليه.',
+    verdict:
+      'لو أولويتك المحتوى العربي، دراما رمضان، والبث المباشر — شاهد VIP يكسب وبضعف السعر تقريبًا. لو بتدور على أكبر مكتبة عالمية وجودة إنتاج وترجمة ممتازة — نتفليكس هي الاختيار. وناس كتير بتحسمها عملي: شاهد للمحتوى العربي (٤٩ ج.م) + أرخص باقة نتفليكس (١٠٠ ج.م) = ١٤٩ ج.م في الشهر للتغطية الكاملة.',
+    bestFor: [
+      { appIndex: 0, label: 'عاشق الأفلام والمسلسلات العالمية وجودة 4K' },
+      { appIndex: 1, label: 'بيت عربي بيتابع الدراما المصرية والخليجية وMBC' },
+      { appIndex: 1, label: 'مشجع كورة عايز بث مباشر (باقة شاهد الرياضية)' },
+      { appIndex: 0, label: 'محبي الأعمال الأصلية والوثائقيات' },
+    ],
+    criteria: [
+      {
+        label: 'يبدأ من (شهريًا في مصر)',
+        values: ['١٠٠ ج.م', '٤٩ ج.م'],
+        winner: 1,
+      },
+      {
+        label: 'المحتوى العربي',
+        values: [
+          'مكتبة متوسطة + أعمال أصلية عربية متفرقة',
+          'الأضخم عربيًا: حصريات MBC ودراما أول بأول',
+        ],
+        winner: 1,
