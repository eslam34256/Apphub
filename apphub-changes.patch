+      },
+      {
+        label: 'بث مباشر وقنوات',
+        values: ['غير متاح', 'قنوات MBC مباشرة + باقة رياضية'],
+        winner: 1,
+      },
+      {
+        label: 'تحميل ومشاهدة أوفلاين',
+        values: ['متاح', 'متاح'],
+      },
+      {
+        label: 'تجربة مجانية',
+        values: ['غير متاحة حاليًا', '7 أيام عند الاشتراك الأول (تتغير حسب العروض)'],
+        winner: 1,
+      },
+      {
+        label: 'الترجمة والدبلجة العربية',
+        values: ['ممتازة — ترجمة احترافية لمعظم المحتوى', 'جيدة على المحتوى الأجنبي المتاح'],
