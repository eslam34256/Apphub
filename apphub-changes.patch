+                      row.winner === vi
+                        ? "bg-sage-50 font-bold text-sage-700"
+                        : "text-charcoal-500"
+                    }`}
+                  >
+                    {row.winner === vi && (
+                      <span className="ml-1 inline-block rounded-full bg-sage-600 px-2 py-0.5 text-[10px] font-bold text-white">
+                        الأفضل ✓
+                      </span>
+                    )}
+                    {v}
+                  </td>
+                ))}
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  );
+}
